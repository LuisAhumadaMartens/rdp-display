#!/usr/bin/env python3
"""Automatic display profiles for GNOME Remote Desktop.

    rdp-display modes            list every mode and the scales mutter accepts
    rdp-display status           current mode, scale, profile, session count
    rdp-display config           show the loaded configuration and its source
    rdp-display apply <profile>  force a profile
    rdp-display watch            run the watcher
"""

import os
import shutil
import subprocess
import sys
import time
import tomllib

from gi.repository import Gio, GLib

DEST = "org.gnome.Mutter.DisplayConfig"
OBJECT_PATH = "/org/gnome/Mutter/DisplayConfig"
GET_STATE_SIG = "(ua((ssss)a(siiddada{sv})a{sv})a(iiduba(ssss)a{sv})a{sv})"
APPLY_SIG = "(uua(iiduba(ssa{sv}))a{sv})"
APPLY_METHOD_PERSISTENT = 2
SCALE_TOLERANCE = 0.01

DEFAULTS = {
    "connector": "",
    "remote_profile": "remote",
    "local_profile": "local",
    "bounce_after_resize": False,
    "poll_seconds": 0.5,
    "connect_ticks": 2,
    "disconnect_ticks": 30,
    "confirm_delay_seconds": 2.0,
    "reconnect_grace_seconds": 60,
    "max_asserts": 3,
    "assert_window_seconds": 900,
}

config = dict(DEFAULTS, profiles={})
config_source = "(defaults)"
connector = ""


def log(message):
    print(message, flush=True)


def fail(message):
    raise SystemExit("rdp-display: %s" % message)


def config_path():
    override = os.environ.get("RDP_DISPLAY_CONFIG")
    if override:
        return override
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "rdp-display", "config.toml")


def load_config():
    global config, config_source
    path = config_path()
    if not os.path.exists(path):
        fail("no configuration at %s\n"
             "         copy config.example.toml there and edit it" % path)
    try:
        with open(path, "rb") as handle:
            data = tomllib.load(handle)
    except tomllib.TOMLDecodeError as exc:
        fail("%s is not valid TOML: %s" % (path, exc))

    loaded = dict(DEFAULTS)
    for key, value in data.items():
        if key != "profiles":
            loaded[key] = value
    loaded["profiles"] = data.get("profiles", {})

    config = loaded
    config_source = path
    validate_config()


def validate_config():
    profiles = config["profiles"]
    if not profiles:
        fail("%s defines no [profiles]" % config_source)

    for key in ("remote_profile", "local_profile"):
        name = config[key]
        if name not in profiles:
            fail("%s = %r in %s, but no such profile is defined (have: %s)"
                 % (key, name, config_source, ", ".join(sorted(profiles))))

    for name, profile in profiles.items():
        missing = [k for k in ("mode", "scale") if k not in profile]
        if missing:
            fail("profile %r in %s is missing: %s"
                 % (name, config_source, ", ".join(missing)))
    remote = profiles[config["remote_profile"]]
    if float(remote["scale"]) % 1 != 0:
        log("warning: remote profile %r uses fractional scale %s, which inflates "
            "the framebuffer and can exceed the GPU encoder limit"
            % (config["remote_profile"], remote["scale"]))


def connect_bus():
    return Gio.bus_get_sync(Gio.BusType.SESSION, None)


def get_state(bus):
    result = bus.call_sync(DEST, OBJECT_PATH, DEST, "GetCurrentState", None,
                           GLib.VariantType(GET_STATE_SIG),
                           Gio.DBusCallFlags.NONE, -1, None)
    return result.unpack()


def resolve_connector(bus):
    global connector
    if connector:
        return connector
    if config["connector"]:
        connector = config["connector"]
        return connector
    _serial, monitors, logical, _props = get_state(bus)
    for _x, _y, _scale, _transform, primary, monitor_specs, _props2 in logical:
        if primary and monitor_specs:
            connector = monitor_specs[0][0]
            return connector
    if monitors:
        connector = monitors[0][0][0]
        return connector
    fail("mutter reports no monitors")


def list_modes(bus):
    _serial, monitors, _logical, _props = get_state(bus)
    for spec, modes, _props2 in monitors:
        print("%s  (%s %s)" % (spec[0], spec[1], spec[2]))
        for mode_id, _w, _h, _refresh, _preferred, scales, flags in modes:
            print("   %-24s scales=%s %s"
                  % (mode_id, [round(s, 3) for s in scales],
                     " ".join(sorted(flags))))


def read_current(bus):
    serial, monitors, logical, _props = get_state(bus)

    mode = None
    for spec, modes, _props2 in monitors:
        if spec[0] != connector:
            continue
        for mode_id, _w, _h, _refresh, _preferred, _scales, flags in modes:
            if flags.get("is-current"):
                mode = mode_id

    scale = None
    for _x, _y, current_scale, _transform, _primary, specs, _props2 in logical:
        if any(spec[0] == connector for spec in specs):
            scale = current_scale

    return serial, mode, scale


def matches(profile, mode, scale):
    return (mode == profile["mode"]
            and scale is not None
            and abs(scale - float(profile["scale"])) < SCALE_TOLERANCE)


def current_profile(bus):
    _serial, mode, scale = read_current(bus)
    if scale is None:
        return None
    for name, profile in config["profiles"].items():
        if matches(profile, mode, scale):
            return name
    return None


def apply_profile(bus, name):
    profile = config["profiles"][name]
    serial, mode, scale = read_current(bus)
    if matches(profile, mode, scale):
        return False

    logical = [(0, 0, float(profile["scale"]), 0, True,
                [(connector, profile["mode"], {})])]
    args = GLib.Variant(APPLY_SIG,
                        (serial, APPLY_METHOD_PERSISTENT, logical, {}))
    bus.call_sync(DEST, OBJECT_PATH, DEST, "ApplyMonitorsConfig", args, None,
                  Gio.DBusCallFlags.NONE, -1, None)
    return True


def rdp_sessions():
    try:
        completed = subprocess.run(["ss", "-Htnp", "state", "established"],
                                   capture_output=True, text=True, timeout=5)
    except Exception:
        return None
    return sum(1 for line in completed.stdout.splitlines()
               if "gnome-remote-de" in line)


def confirm_display_change():
    if not shutil.which("xdotool"):
        log("xdotool not found; the display change will revert in ~20s")
        return False
    time.sleep(config["confirm_delay_seconds"])
    subprocess.run(["xdotool", "key", "--clearmodifiers", "Return"],
                   timeout=10, check=False)
    return True


def restart_grd():
    subprocess.run(["systemctl", "--user", "restart", "gnome-remote-desktop"],
                   timeout=30, check=False)


def watch():
    bus = connect_bus()
    resolve_connector(bus)

    remote = config["remote_profile"]
    local = config["local_profile"]
    poll = config["poll_seconds"]
    window = config["assert_window_seconds"]
    budget = config["max_asserts"]

    pending = None
    ticks = 0
    grace_until = 0.0
    applies = []
    last_want = None

    log("watching %s: %s when connected, %s when idle"
        % (connector, remote, local))

    while True:
        time.sleep(poll)
        now = time.monotonic()

        sessions = rdp_sessions()
        if sessions is None:
            continue
        if sessions == 0 and now < grace_until:
            continue

        want = remote if sessions > 0 else local

        try:
            live = current_profile(bus)
        except Exception as exc:
            log("could not read display state: %s" % exc)
            try:
                bus = connect_bus()
            except Exception:
                pass
            continue

        if want != last_want:
            last_want, applies = want, []

        if live == want:
            pending, ticks = None, 0
            continue

        applies = [stamp for stamp in applies if now - stamp < window]
        if len(applies) >= budget:
            continue

        needed = config["connect_ticks"] if want == remote else config["disconnect_ticks"]
        if want == pending:
            ticks += 1
        else:
            pending, ticks = want, 1
        if ticks < needed:
            continue

        try:
            changed = apply_profile(bus, want)
            log("%d session(s), %s -> %s" % (sessions, live, want))
            if changed:
                applies.append(time.monotonic())
                confirm_display_change()
                if len(applies) >= budget:
                    log("%s keeps reverting; giving up for %d minutes"
                        % (want, window // 60))
                if config["bounce_after_resize"] and want == remote and sessions > 0:
                    restart_grd()
                    grace_until = time.monotonic() + config["reconnect_grace_seconds"]
                    log("restarted gnome-remote-desktop; client should reconnect")
            pending, ticks = None, 0
        except Exception as exc:
            log("could not apply %s: %s" % (want, exc))
            try:
                bus = connect_bus()
            except Exception:
                pass
            ticks = max(0, needed - 1)


def show_config():
    print("source    : %s" % config_source)
    print("connector : %s" % (config["connector"] or "(auto)"))
    print("remote    : %s" % config["remote_profile"])
    print("local     : %s" % config["local_profile"])
    print("profiles  :")
    for name, profile in sorted(config["profiles"].items()):
        print("   %-14s %-22s scale %s"
              % (name, profile["mode"], profile["scale"]))


def show_status(bus):
    resolve_connector(bus)
    _serial, mode, scale = read_current(bus)
    sessions = rdp_sessions()
    print("connector : %s" % connector)
    print("mode      : %s" % mode)
    print("scale     : %s" % scale)
    print("profile   : %s" % (current_profile(bus) or "(unrecognised)"))
    print("sessions  : %s" % ("unknown" if sessions is None else sessions))


def usage(code):
    print(__doc__)
    if config["profiles"]:
        print("profiles: %s" % ", ".join(sorted(config["profiles"])))
    return code


def main():
    args = sys.argv[1:]
    if not args:
        return usage(1)

    command = args[0]

    if command == "modes":
        list_modes(connect_bus())
        return 0

    load_config()

    if command == "watch":
        watch()
        return 0

    if command == "config":
        show_config()
        return 0

    if command == "status":
        show_status(connect_bus())
        return 0

    if command == "apply":
        if len(args) < 2:
            return usage(1)
        name = args[1]
        if name not in config["profiles"]:
            fail("no profile %r in %s (have: %s)"
                 % (name, config_source, ", ".join(sorted(config["profiles"]))))
        bus = connect_bus()
        resolve_connector(bus)
        if apply_profile(bus, name):
            confirm_display_change()
            print("applied %s" % name)
        else:
            print("already on %s" % name)
        return 0

    return usage(1)


if __name__ == "__main__":
    sys.exit(main())
